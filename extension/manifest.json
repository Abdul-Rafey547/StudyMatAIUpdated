{
  "manifest_version": 3,
  "name": "StudyMate AI",
  "version": "1.0.0",
  "description": "AI-powered student assistant for Moodle LMS platforms.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://moodle.local/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "StudyMate AI",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_page": "dashboard/dashboard.html",
  "content_scripts": [
    {
      "matches": [
        "http://moodle.local/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content/moodle_detector.js",
        "content/assignment_scanner.js",
        "content/quiz_scanner.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}