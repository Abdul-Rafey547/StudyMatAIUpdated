# StudyMate AI Server Configuration
API_PORT=5000
API_HOST=127.0.0.1
SECRET_KEY=your-secret-key-here

# -------------------------------------------------------------
# AI Provider Configuration
# Supported providers: google | claude | groq | openai | deepseek | ollama | fallback
# -------------------------------------------------------------
AI_PROVIDER=google
AI_MODEL_NAME=

# Fallback to local intelligent academic generator if API error or quota limit occurs
AI_FALLBACK_ON_ERROR=true

# Generic API Key (used for whatever AI_PROVIDER is chosen above)
AI_API_KEY=your-ai-api-key-here

# Provider-Specific API Keys (Optional - override generic AI_API_KEY)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# -------------------------------------------------------------
# Moodle LMS Web Services Configuration
# -------------------------------------------------------------
MOODLE_URL=http://moodle.local
MOODLE_TOKEN=your-moodle-web-services-token-here
